# Official XWA PDFs: used locally by the build tools, not redistributed
/pdfs/
# Original font folder (the site only uses the copies in site/fonts/)
/fonts/
# Node packages (reinstall with: cd tools && npm install)
node_modules/
# Python / OS clutter
__pycache__/
*.pyc
.DS_Store
Thumbs.db
.claude/
# Playtest site: the build output, the real playtest content and the password never go in a repository
/build/
/data/playtest-private.json
/data/playtest-password.txt
